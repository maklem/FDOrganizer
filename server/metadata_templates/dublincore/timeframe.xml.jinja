{% for timeframe in (metadata.timeframe | default([], true)) %}
    {% if timeframe.timeframeType[0] == "point" %}
        <dc:coverage>{{timeframe.timeframePoint | first | timestamp_to_date}}</dc:coverage>
    {% elif timeframe.timeframeType[0] == "range" %}
        <dc:coverage>{{timeframe.timeframeRangeStart | first | timestamp_to_date}} - {{timeframe.timeframeRangeEnd | first | timestamp_to_date}}</dc:coverage>
    {% elif timeframe.timeframeType[0] == "event" %}
        <dc:coverage>{{timeframe.timeframeEvent | first | timestamp_to_date}}</dc:coverage>
    {% endif %}
{% endfor %}