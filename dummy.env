
# CouchDB configuration
COUCHDB_USER=MyCouchDBUser
COUCHDB_PASSWORD=MyPassword
COUCHDB_HOST=127.0.0.1
COUCHDB_PORT=5984

# Where to export files to *after* review
EXPORT_DIR=/server/export/

# Name or ID of user, that owns exported files
# In dummy data it is root
EXPORT_USER=0

# Imprint. For legal purposes.
IMPRESSUM_LINK=https://localhost:5000/impressum

# Generate a secret (i.e. `openssl rand -base64 64`) and replace this value.
# It is used to encrypt/sign cookies, that allow identification,
# and persists over service restarts.
# If known, attackers can bypass authentication for any user.
TOKEN_SECRET=git-is-not-secret.

# Keycloak Admin for Docker Compose
KEYCLOAK_ADMIN=dummy-admin
KEYCLOAK_ADMIN_PASSWORD=dummy-password
