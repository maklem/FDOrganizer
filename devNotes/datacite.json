                {
                    "id": "rights_uri",
                    "label": "Rights URI",
                    "type": "string",
                    "max": 1,
                    "description": "The URI of the license."
                },
                {
                    "id": "rights_identifier",
                    "label": "Rights Identifier",
                    "type": "string",
                    "max": 1,
                    "description": "A short, standardized version of the license name."
                },
                {
                    "id": "rights_identifier_scheme",
                    "label": "Scheme",
                    "type": "string",
                    "max": 1,
                    "description": "The name of the rights scheme."
                },
                {
                    "id": "rights_scheme_uri",
                    "label": "Scheme URI",
                    "type": "string",
                    "max": 1,
                    "description": "The URI of the Scheme"
                }
            ]
        },
        {
            "id": "description_group",
            "label": "Description",
            "fields": [
                {
                    "id": "description",
                    "label": "Description",
                    "type": "string",
                    "max": 1,
                    "description": "An additional information further describing the resource."
                },
                {
                    "id": "description_type",
                    "label": "Description Type",
                    "type": "monoselect",
                    "min": 1,
                    "max": 1,
                    "description": "The type of description.",
                    "options": [
                        "Abstract",
                        "Methods",
                        "Series Information",
                        "Table Of Contents",
                        "Technical Info",
                        "Other"
                    ]
                }
            ]
        },
        {
