            "fields": [
                {
                    "id": "date",
                    "label": "Date",
                    "type": "string",
                    "max": 1,
                    "description": "Different dates relevant to the resource."
                },
                {
                    "id": "date_type",
                    "label": "Date Type",
                    "type": "monoselect",
                    "min": 1,
                    "max": 1,
                    "description": "The type of date.",
                    "options": [
                        "Accepted",
                        "Available",
                        "Copyrighted",
                        "Collected",
                        "Created",
                        "Issued",
                        "Submitted",
                        "Updated",
                        "Valid",
                        "Withdrawn",
                        "Other"
                    ]
                },
                {
                    "id": "date_information",
                    "label": "Date Information",
                    "type": "string",
                    "max": 1,
                    "description": "Specific Information about the date."
                }
            ]
        },
        {
            "id": "language",
            "label": "Language",
            "type": "string",
            "description": "The primary language of the resource."
        },
        {
            "id": "alternate_identifier_group",
            "label": "Alternate Identifier",
            "fields": [
                {
                    "id": "alternate_identifier",
                    "label": "Alternate Identifier",
                    "type": "string",
                    "max": 1,
                    "description": "An identifier other than the primary to the resource being registered."
                },
                {
                    "id": "alternate_identifier_type",
                    "label": "Alternate Identifier Type",
                    "type": "string",
                    "max": 1,
                    "description": "The type of the alternate identifier."
                }
            ]
        },
        {
