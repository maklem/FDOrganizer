                    "type": "string",
                    "min": 1,
                    "max": 1,
                    "description": "A description of the resource."
                },
                {
                    "id": "resource_type_general",
                    "label": "Resource Type General",
                    "type": "monoselect",
                    "min": 1,
                    "max": 1,
                    "description": "A general type of a resource.",
                    "options": [
                        "Audiovisual",
                        "Collection",
                        "Data Paper",
                        "Dataset",
                        "Event",
                        "Image",
                        "Interactive Resource",
                        "Model",
                        "Physical Object",
                        "Service",
                        "Software",
                        "Sound",
                        "Text",
                        "Workflow",
                        "Other"
                    ]
                }
            ]
        },
        {
