                    "id": "related_metadata_scheme",
                    "label": "Related Metadata Scheme",
                    "type": "string",
                    "max": 1,
                    "description": "The name of the scheme. Use only with \"Has Metadata/Is Metadata For\"."
                },
                {
                    "id": "related_metadata_scheme_uri",
                    "label": "Related Metadata Scheme URI",
                    "type": "string",
                    "max": 1,
                    "description": "The name of the scheme uri. Use only with \"Has Metadata/Is Metadata For\"."
                },
                {
                    "id": "related_metadata_scheme_type",
                    "label": "Related Metadata Scheme Type",
                    "type": "string",
                    "max": 1,
                    "description": "The type of the scheme. Use only with \"Has Metadata/Is Metadata For\"."
                },
                {
                    "id": "related_resource_type_general",
                    "label": "Related Resource Type",
                    "type": "monoselect",
                    "max": 1,
                    "options": [
                        "Audiovisual",
                        "Collection",
                        "Data Paper",
                        "Dataset",
                        "Event",
                        "Image",
                        "Interactive Resource",
                        "Model",
                        "Physical Object",
                        "Service",
                        "Software",
                        "Sound",
                        "Text",
                        "Workflow",
