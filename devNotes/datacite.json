                            "type": "string",
                            "max": 1,
                            "description": "Longitudinal dimension of the geolocation point."
                        },
                        {
                            "id": "geolocation_point_latitude",
                            "label": "Point Latitude",
                            "type": "string",
                            "max": 1,
                            "description": "Latitudinal dimension of the geolocation point."
                        }
                    ]
                },
                {
                    "id": "geolocation_box_group",
                    "label": "Geolocation Box",
                    "max": 1,
                    "fields": [
                        {
                            "id": "geolocation_box_west_bound",
                            "label": "Box Western Longitude",
                            "type": "string",
                            "max": 1,
                            "description": "Western Longitudinal dimension of the box."
                        },
                        {
                            "id": "geolocation_box_east_bound",
                            "label": "Box Easter Longitude",
                            "type": "string",
                            "max": 1,
                            "description": "Eastern Longitudinal dimension of the box."
