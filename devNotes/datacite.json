                {
                    "id": "contributor_given_name",
                    "label": "Given Name",
                    "type": "string",
                    "max": 1
                },
                {
                    "id": "contributor_family_name",
                    "label": "Family Name",
                    "type": "string",
                    "max": 1
                },
                {
                    "id": "contributor_identifier_group",
                    "label": "Contributor identifiers",
                    "fields": [
                        {
                            "id": "contributor_name_identifier",
                            "label": "Contributor Identifier",
                            "type": "string",
                            "max": 1
                        },
                        {
                            "id": "contributor_name_identifier_scheme",
                            "label": "Identifier Scheme",
                            "type": "monoselect",
                            "min": 1,
                            "max": 1,
                            "options": [
                                "GND",
                                "ORCID"
                            ]
                        },
                        {
                            "id": "contributor_name_identifier_scheme_uri",
                            "label": "Identifier Scheme URI",
                            "type": "string",
                            "max": 1
                        }
                    ]
                },
                {
                    "id": "contributor_affiliation_group",
                    "label": "Contributor affiliations",
                    "fields": [
                        {
                            "id": "contributor_affiliation",
                            "label": "Affiliation",
                            "type": "string",
                            "max": 1
                        },
                        {
                            "id": "contributor_affiliation_identifier",
                            "label": "Affiliation Identifier",
                            "type": "string",
                            "max": 1
                        },
                        {
                            "id": "contributor_affiliation_identifier_scheme",
                            "label": "Affiliation Scheme",
                            "type": "monoselect",
                            "max": 1,
                            "options": [
                                "GND",
                                "ORCID"
                            ]
                        },
                        {
                            "id": "contributor_affiliation_identifier_scheme_uri",
                            "label": "Affiliation Scheme URI",
                            "type": "string",
                            "max": 1
                        }
                    ]
                }
