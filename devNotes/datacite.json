            "max": 1,
            "fields": [
                {
                    "id": "subject",
                    "label": "Subject",
                    "type": "string",
                    "max": 1
                },
                {
                    "id": "subject_scheme",
                    "label": "Subject Scheme",
                    "type": "string",
                    "max": 1
                },
                {
                    "id": "subject_scheme_uri",
                    "label": "Scheme URI",
                    "type": "string",
                    "max": 1
                },
                {
                    "id": "subject_scheme_uri_value",
                    "label": "URI Value",
                    "type": "string",
                    "max": 1
                }
            ]
        },
        {
