{
    "version": "1.1",
    "fields": [
        {
            "id": "identifier_group",
            "label": "Identifiers",
            "min": 1,
            "description": "Unique identifier of the Resource.",
            "fields": [
                {
                    "id": "identifier",
                    "label": "Identifier",
                    "type": "string",
                    "min": 1,
                    "max": 1,
                    "description": "Unique Identifier of the Item (DOI,...)"
                },
                {
                    "id": "identifier_type",
                    "label": "Identifier Type",
                    "type": "monoselect",
                    "min": 1,
                    "max": 1,
                    "description": "The type of the main identifier.",
                    "options": [
                        "DOI"
                    ]
                }
            ]
        },
        {
            "id": "title_group",
            "label": "Titles",
            "min": 1,
            "fields": [
                {
                    "id": "title",
                    "label": "Title",
                    "type": "string",
                    "min": 1,
                    "max": 1,
                    "description": "A name or title by which a resource is known. May be the title of a dataset or the name of a piece of software."
                },
                {
                    "id": "title_type",
                    "label": "Title Type",
                    "type": "monoselect",
                    "max": 1,
                    "description": "The type of the title.",
                    "options": [
                        "Main Title",
                        "Alternativ Title",
                        "Subtitle",
                        "Translated Title",
                        "Other"
                    ]
                }
            ]
        },
        {
            "id": "creator_group",
            "label": "Creator(s)",
            "min": 1,
            "fields": [
                {
                    "id": "creator",
                    "label": "Creator",
                    "type": "string",
                    "min": 1,
                    "max": 1,
                    "description": "Main Creator of the Item. (Family Name, Given Name)"
                },
                {
                    "id": "creator_name_type",
                    "label": "Name Type",
                    "type": "monoselect",
                    "min": 1,
                    "max": 1,
                    "options": [
                        "Personal",
                        "Organizational"
                    ]
                },
                {
                    "id": "creator_given_name",
                    "label": "Given Name",
                    "type": "string",
                    "max": 1
                },
                {
                    "id": "creator_family_name",
                    "label": "Family Name",
                    "type": "string",
                    "max": 1
                },
                {
                    "id": "creator_identifier_group",
                    "label": "Creator identifiers",
                    "fields": [
                        {
                            "id": "creator_name_identifier",
                            "label": "Creator Identifier",
                            "type": "string",
                            "max": 1
                        },
                        {
                            "id": "creator_name_identifier_scheme",
                            "label": "Identifier Scheme",
                            "type": "monoselect",
                            "min": 1,
                            "max": 1,
                            "options": [
                                "GND",
                                "ORCID"
                            ]
                        },
                        {
                            "id": "creator_name_identifier_scheme_uri",
                            "label": "Identifier Scheme URI",
                            "type": "string",
                            "max": 1
                        }
                    ]
                },
                {
                    "id": "creator_affiliation_group",
                    "label": "Creator affiliations",
                    "fields": [
                        {
                            "id": "creator_affiliation",
                            "label": "Affiliation",
                            "type": "string",
                            "max": 1
                        },
                        {
                            "id": "creator_affiliation_identifier",
                            "label": "Affiliation Identifier",
                            "type": "string",
                            "max": 1
                        },
                        {
                            "id": "creator_affiliation_identifier_scheme",
                            "label": "Affiliation Scheme",
                            "type": "monoselect",
                            "max": 1,
                            "options": [
                                "GND",
                                "ORCID"
                            ]
                        },
                        {
                            "id": "creator_affiliation_identifier_scheme_uri",
                            "label": "Affiliation Scheme URI",
                            "type": "string",
                            "max": 1
                        }
                    ]
                }
            ]
        },
        {
            "id": "publisher",
            "label": "Publisher",
            "type": "string",
            "min": 1,
            "max": 1,
            "description": "Publisher of the Resource."
        },
        {
            "id": "publication_year",
            "label": "Publication Year",
            "type": "integer",
            "min": 1,
            "max": 1,
            "description": "Publication Year of the Item."
        },
        {
            "id": "resource_type_group",
            "label": "Resource Type",
            "max": 1,
            "min": 1,
            "fields": [
                {
                    "id": "resource_type",
