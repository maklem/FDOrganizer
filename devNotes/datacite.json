                                    "max": 1,
                                    "description": "Longitude dimension of a point defining the inside of the polygon."
                                },
                                {
                                    "id": "geolocation_polygon_in_point_latitude",
                                    "label": "Latitude dimension.",
                                    "type": "string",
                                    "max": 1,
                                    "description": "Latitude dimension of a point defining the inside of the polygon."
                                }
                            ]
                        }
