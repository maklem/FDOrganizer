                    "type": "monoselect",
                    "min": 1,
                    "max": 1,
                    "description": "Description of the relationship of the resource being registered and the related resource.",
                    "options": [
                        "isCitedBy",
                        "Cites",
                        "Is Supplement To",
                        "Is Supplemented By",
                        "Is Continued By",
                        "Continues",
                        "Is Described By",
                        "Describes",
                        "Has Metadata",
                        "Is Metadata For",
                        "Has Version",
                        "Is Version Of",
                        "Is New Version Of",
                        "is Previous Version Of",
                        "Is Part Of",
                        "Has Part",
                        "Is Referenced By",
                        "References",
                        "Is Documented By",
                        "Documents",
                        "Is Compiled By",
                        "Compiles",
                        "Is Variant Form Of",
                        "Is Original Form Of",
                        "Is Identical To",
                        "Is Reviewed By",
                        "Reviews",
                        "Is Derived From",
                        "Is Source Of",
                        "Is Required By",
                        "Requires",
                        "Is Obsoleted By",
                        "Obsoletes"
                    ]
                },
