{
  "type" : "array",
  "schemes" : {
  "type": "object",
  "properties": {
    "title" : {
      "type" : "string",
      "description" : "name of the meta data schema (f.e. Dublin Core )"
    },
    "version" : {
      "type" : "string",
      "description" : "version of the meta data schema (f.e. 1.3)"
    },
    "fields" : {
      "type" : "array",
      "items" : {
        "type" : "object",
        "properties" : {
          "field_name" : {
            "type" : "string",
            "description" : "name of the field"
          },
          "field_type" : {
            "type" : "string",
            "enum" : ["string", "int", "float", "cv"],
            "description" : "data type in the field"
          },
          "field_verfication": {
            "type" : "string",
            "description" : "regex string to verify integrity of the date, optional!"
          },
          "field_mandatory" : {
            "type" : "boolean",
            "description" : "field is mandatory?"
          },
          "field_multiple" : {
            "type" : "boolean",
            "description" : "can multiple instances of this field exist?"
          },
          "field_description" : {
            "type" : "string",
            "description" : "description of the field Contents, extends title"
          },
          "field_options" : { //pickable option of a cv field. mandatory when dropdown is selected
            "type" : "array",
            "items" : {
              "type" : "string",
              "description" : "name of the pickable option"
            }
          }
        },
        "required" : ["field_name","field_type","field_mandatory"]
      }
    }
  }
}
}
