{
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "title",
      "version",
      "identifier"
    ],
    "properties": {
      "title": {
        "type": "string",
        "description": "name of the meta data schema (f.e. Dublin Core )"
      },
      "version": {
        "type": "string",
        "description": "version of the meta data schema (f.e. 1.3)"
      },
      "identifier": {
        "type": "string",
        "description": "unique of identifier of scheme/version"
      },
      "active": {
        "type": "boolean",
        "description": "defines if the scheme is active and is actively displayed"
      },
      "fields": {
        "type": "array",
        "$id": "entity_element",
        "minItems": 1,
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "entity_type": {
                  "type": "string",
                  "const": "GROUP",
                  "description": "type of the element"
                },
                "name": {
                  "type": "string",
                  "description": "spoken word of the field"
                },
                "identifier": {
                  "type": "string",
                  "description": "identifier of the field"
                },
                "mandatory": {
                  "type": "boolean",
                  "description": "field is mandatory?"
                },
                "multiple": {
                  "type": "boolean",
                  "description": "can multiple instances of this field exist?"
                },
                "description": {
                  "type": "string",
                  "description": "description of the field Contents, extends title"
                },
                "fields": {
                  "$ref": "entity_element"
                }
              },
              "required": [
                "entity_type",
                "identifier",
                "name",
                "mandatory"
              ]
            },
            {
              "type": "object",
              "properties": {
                "entity_type": {
                  "type": "string",
                  "const": "FIELD",
                  "description": "type of the element"
                },
                "name": {
                  "type": "string",
                  "description": "spoken word of the field"
                },
                "identifier": {
                  "type": "string",
                  "description": "identifier of the field"
                },
                "mandatory": {
                  "type": "boolean",
                  "description": "field is mandatory?"
                },
                "multiple": {
                  "type": "boolean",
                  "description": "can multiple instances of this field exist?"
                },
                "description": {
                  "type": "string",
                  "description": "description of the field Contents, extends title"
                },
                "field_blank_text": {
                  "type": "string",
                  "description": "blank text which will be displayed in the empty field"
                },
                "field_type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "int",
                    "float",
                    "cv"
                  ],
                  "description": "data type in the field"
                },
                "field_verfication": {
                  "type": "string",
                  "description": "regex string to verify integrity of the date, optional!"
                },
                "field_options": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "name of the pickable option"
                  }
                }
              },
              "required": [
                "entity_type",
                "identifier",
                "name",
                "field_type",
                "mandatory"
              ]
            }
          ]
        }
      }
    }
  }
}